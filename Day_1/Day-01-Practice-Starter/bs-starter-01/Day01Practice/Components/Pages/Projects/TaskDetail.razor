@page "/projects/{ProjectId:int}/tasks/{TaskId:int}"

<PageTitle>Task Detail</PageTitle>

<h1>Task Detail</h1>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="projects/1/tasks">Project @ProjectId</a></li>
        <li class="breadcrumb-item active">Task @TaskId</li>
    </ol>
</nav>

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">Task #@TaskId</h5>
        <dl class="row mb-0">
            <dt class="col-sm-3">Project ID</dt>
            <dd class="col-sm-9">@ProjectId</dd>
            <dt class="col-sm-3">Task ID</dt>
            <dd class="col-sm-9">@TaskId</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9"><span class="badge bg-warning text-dark">In Progress</span></dd>
            <dt class="col-sm-3">Assigned To</dt>
            <dd class="col-sm-9">Bob Smith</dd>
        </dl>
    </div>
</div>

@code {
    [Parameter]
    public int ProjectId { get; set; }

    [Parameter]
    public int TaskId { get; set; }
}
