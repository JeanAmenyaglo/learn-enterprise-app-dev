@page "/projects/{ProjectId:int}/settings"
<PageTitle>Project Settings</PageTitle>

<h1>Project @ProjectId -- Settings</h1>
...
<input type="text" class="form-control" value="Project @ProjectId" readonly />

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">Project Configuration</h5>
        <div class="mb-3">
            <label class="form-label">Project Name</label>
            <input type="text" class="form-control" value="Project ???" readonly />
        </div>
        <div class="mb-3">
            <label class="form-label">Visibility</label>
            <select class="form-select" disabled>
                <option selected>Private</option>
                <option>Public</option>
            </select>
        </div>
    </div>
</div>

@code {
    [Parameter]
public int ProjectId { get; set; }
}
