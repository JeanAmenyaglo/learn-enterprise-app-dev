@page "/colors/{*Slug}"

@if (string.IsNullOrEmpty(Slug) || Slug.Equals("index", StringComparison.OrdinalIgnoreCase))
{
    <h3>Colors</h3>
    <ul>
        @foreach (var color in _knownColors.Keys)
        {
            <li><a href="/colors/@color">@color</a></li>
        }
    </ul>
}
else if (_knownColors.TryGetValue(Slug, out var hex))
{
    <h3>@Slug</h3>
    <p>Hex: @hex</p>
    <div style="width: 100px; height: 100px; background-color: @hex;"></div>
}
else
{
    <h3>Color Not Found</h3>
    <p>No color matches: @Slug</p>
}

@code {
    [Parameter]
    public string? Slug { get; set; }

    // PRE-BUILT — not part of the exercise.
    // This dictionary stands in for a database lookup. A real app would query a table
    // of colors here. The KEY is the slug taken from the URL; the VALUE is the hex code.
    private readonly Dictionary<string, string> _knownColors = new(StringComparer.OrdinalIgnoreCase)
    {
        ["red"] = "#FF0000",
        ["green"] = "#00FF00",
        ["blue"] = "#0000FF"
    };
}